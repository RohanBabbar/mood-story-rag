# Groq API key (free tier): with it, stories are written by gpt-oss-120b on Groq.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: Hugging Face token with the "Make calls to Inference Providers" permission.
# Only needed for TEXT_PROVIDER=hf or IMAGE_PROVIDER=hf. https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# "api" (default): hosted text models, no GPU needed
# "local": run LLaMA + Stable Diffusion on this machine (pip install -r requirements-local.txt)
MODEL_BACKEND=api

# Optional overrides
# TEXT_PROVIDER=groq            # or "hf"; defaults to groq when GROQ_API_KEY is set
# IMAGE_PROVIDER=sd-turbo       # or "hf" (FLUX, needs HF credits); defaults to sd-turbo with Groq
# TEXT_MODEL=openai/gpt-oss-120b
# ADAPTER_REPO=your-username/your-lora-adapter   # local backend only
