# Hugging Face token with the "Make calls to Inference Providers" permission
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# "api" (default): hosted models via HF Inference Providers, no GPU needed
# "local": run LLaMA + Stable Diffusion on this machine (pip install -r requirements-local.txt)
MODEL_BACKEND=api

# Optional model overrides
# ADAPTER_REPO=your-username/your-lora-adapter   # local backend only
# TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
